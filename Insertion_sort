#include<stdio.h>
int main()
{
    int a[5]={4,2,5,7,1};
    int i,j,temp,n,key;
    n=sizeof(a)/sizeof(a[0]);
    for(i=1;i<n;i++)
        {
            key=a[i];
            j=i-1;
            while(j>=0&&a[j]>key)
                {
                    a[j+1]=a[j];
                    j--;
                }
            a[j+1]=key;
        }
    for(i=0;i<n;i++)
        {
            printf("%d ",a[i]);
        }
    return 0;
}
