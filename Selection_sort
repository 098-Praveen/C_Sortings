#include<stdio.h>
int main()
{
    int a[5]={50,20,40,10,30};
    int i,j,curr,temp,n;
    n=sizeof(a)/sizeof(a[0]);
    for(i=0;i<n-1;i++)
        {
            curr=i;
            for(j=i+1;j<n;j++)
                {
                    if(a[j]<a[curr])
                    {
                        temp=a[j];
                        a[j]=a[curr];
                        a[curr]=temp;
                    }
                }
        }
    for(i=0;i<n;i++)
        {
            printf("%d ",a[i]);
        }
    return 0;    
}
